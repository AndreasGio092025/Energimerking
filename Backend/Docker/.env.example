# Kopier til .env (som ikke ligger i Git) og bytt passordene om du vil.
# Byttes POSTGRES_PASSWORD, må ConnectionStrings:Postgres i WebApi også endres.
# Postgres leser disse bare første gang databasen lages (tomt volum).
POSTGRES_DB=Energimerking
POSTGRES_USER=Kodehode
POSTGRES_PASSWORD=12345

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=securepassword
